{% extends 'app_layout.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block page_title %}Dashboard{% endblock %}

{% block content %}
    {# Welcome Banner - Con fallback por tenant #}
    {{ include_tenant_component('_welcome_banner.html.twig') }}
    
    {# Stats Cards - Métricas principales #}
    {{ include_tenant_component('_stats_cards.html.twig') }}
    
    {# Content Grid - Tabla de citas y sidebar #}
    <div class="content-grid">
        {# Appointments Table #}
        {{ include_tenant_component('_appointments_table.html.twig') }}
        
        {# Sidebar Actions #}
        <div>
            {# Quick Actions #}
            {{ include_tenant_component('_quick_actions.html.twig') }}
            
            {# Daily Summary #}
            {{ include_tenant_component('_daily_summary.html.twig') }}
        </div>
    </div>
    
    {# Dashboard Styles #}
    {{ include_tenant_component('_dashboard_styles.html.twig') }}
{% endblock %}
