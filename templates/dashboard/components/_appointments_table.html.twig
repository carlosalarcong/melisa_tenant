{# Today's Appointments Table #}
<div class="card">
    <div class="card-header">
        <h5>
            <i class="fas fa-calendar-day" style="color: var(--success-color);"></i>
            Agenda de Hoy
        </h5>
        <span class="status-badge success">23 citas</span>
    </div>
    <div class="card-body p-0">
        <table class="table-modern">
            <thead>
                <tr>
                    <th>Hora</th>
                    <th>Paciente</th>
                    <th>Motivo</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><span class="time-badge">09:00</span></td>
                    <td>
                        <div class="patient-info">
                            <div class="patient-avatar" style="background: linear-gradient(135deg, #5e72e4, #825ee4);">MG</div>
                            <div>
                                <div class="patient-name">María González</div>
                                <div class="patient-id">19.456.789-0</div>
                            </div>
                        </div>
                    </td>
                    <td>Control general</td>
                    <td><span class="status-badge success">Confirmada</span></td>
                    <td>
                        <div class="btn-group">
                            <button class="btn btn-outline-secondary btn-sm"><i class="fas fa-eye"></i></button>
                            <button class="btn btn-outline-primary btn-sm"><i class="fas fa-stethoscope"></i></button>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="card-footer">
        <button class="btn btn-primary">
            <i class="fas fa-calendar-alt"></i>
            Ver Agenda Completa
        </button>
    </div>
</div>
