<turbo-frame id="admission-wizard-content">
    <div class="card shadow-sm border-0 mt-4">
        <div class="card-body p-4">
            <h4 class="mb-3">Paso 2 de 3: Financiador y convenio</h4>

            <form method="post" action="{{ path('app_admission_wizard_step2') }}">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="payer" class="form-label">Financiador</label>
                        <input id="payer"
                               name="payer"
                               type="text"
                               class="form-control"
                               value="{{ wizard.payer|default('') }}"
                               required>
                    </div>
                    <div class="col-md-6">
                        <label for="agreement" class="form-label">Convenio</label>
                        <input id="agreement"
                               name="agreement"
                               type="text"
                               class="form-control"
                               value="{{ wizard.agreement|default('') }}"
                               required>
                    </div>
                </div>

                <div class="d-flex gap-2 justify-content-end mt-4">
                    <a href="{{ path('app_admission_wizard_step1', { patientId: wizard.patient_id }) }}"
                       class="btn btn-outline-secondary">
                        Volver
                    </a>
                    <button type="submit" class="btn btn-primary">Siguiente</button>
                </div>
            </form>
        </div>
    </div>
</turbo-frame>

