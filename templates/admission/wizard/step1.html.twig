<turbo-frame id="admission-wizard-content">
    <div class="card shadow-sm border-0 mt-4">
        <div class="card-body p-4">
            <h4 class="mb-3">Paso 1 de 3: Confirmar paciente</h4>
            <p class="text-muted mb-4">Paciente seleccionado: #{{ patient_id }}</p>

            <form method="post" action="{{ path('app_admission_wizard_step1', { patientId: patient_id }) }}">
                <div class="d-flex gap-2 justify-content-end">
                    <a href="{{ path('app_admission_hospitalization_index') }}"
                       class="btn btn-outline-secondary"
                       data-turbo-frame="maintainer-content">
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary">Siguiente</button>
                </div>
            </form>
        </div>
    </div>
</turbo-frame>

