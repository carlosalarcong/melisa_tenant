{% extends 'app_layout.html.twig' %}

{% block title %}{{ page_title }} - Melisa{% endblock %}

{% block content %}
    <div class="container-fluid px-4 py-4">
        <h1>{{ page_title }}</h1>

        <div class="alert alert-info mt-3 mb-4" role="alert">
            Para comenzar con la admisión, primero busca al paciente por documento o nombre.
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-primary text-white">
                Búsqueda de Paciente
            </div>
            <div class="card-body">
                <form method="get" action="{{ path('app_admission_hospitalization_index') }}">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label for="identification_type" class="form-label">Tipo documento</label>
                            <select id="identification_type" name="identification_type" class="form-select">
                                <option value="0">Todos</option>
                                {% for type in identification_types %}
                                    <option value="{{ type.id }}" {% if selected_type_id == type.id %}selected{% endif %}>
                                        {{ type.name }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="q" class="form-label">RUT / Documento / Nombre</label>
                            <input id="q"
                                   type="text"
                                   name="q"
                                   class="form-control"
                                   value="{{ search_term }}"
                                   placeholder="Ejemplo: 12345678-9 o Carlos Alarcón"
                                   required>
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary w-100">
                                Buscar
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        {% if searched %}
            {% if patients is empty %}
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <div class="alert alert-warning mb-3">
                            Paciente no encontrado en la base de datos.
                        </div>
                        <a href="{{ path('app_admission_patient_register', {
                            identification_type: selected_type_id,
                            identification: search_term
                        }) }}"
                           class="btn btn-success"
                           data-turbo-frame="maintainer-content">
                            Agregar paciente
                        </a>
                    </div>
                </div>
            {% else %}
                <div class="card shadow-sm border-0">
                    <div class="card-header">
                        Resultados
                    </div>
                    <div class="table-responsive">
                        <table class="table table-striped mb-0">
                            <thead>
                            <tr>
                                <th>ID</th>
                                <th>Tipo Doc.</th>
                                <th>Identificación</th>
                                <th>Nombre</th>
                                <th>Teléfono</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for patient in patients %}
                                <tr>
                                    <td>#{{ patient.id }}</td>
                                    <td>{{ patient.identificationType ? patient.identificationType.name : '-' }}</td>
                                    <td>{{ patient.identification }}</td>
                                    <td>{{ patient.name }} {{ patient.lastName }} {{ patient.middleName|default('') }}</td>
                                    <td>{{ patient.mobilePhone }}</td>
                                    <td class="text-end">
                                        <a href="{{ path('app_admission_wizard_step1', { patientId: patient.id }) }}"
                                           class="btn btn-primary btn-sm"
                                           data-turbo-frame="admission-wizard-content">
                                            Admitir
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                <turbo-frame id="admission-wizard-content" class="d-block mt-4"></turbo-frame>
            {% endif %}
        {% endif %}
    </div>
{% endblock %}
