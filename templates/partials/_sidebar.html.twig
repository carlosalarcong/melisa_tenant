<style>
/* ========================================
   OPTIMIZACIÓN DE ESPACIO EN SUBMENÚ
   ======================================== */

.submenu {
    background: linear-gradient(to bottom, rgba(139, 92, 246, 0.12), rgba(99, 102, 241, 0.08));
    border-radius: 8px;
    margin-top: 4px;
    margin-bottom: 4px;
    padding-top: 2px;
    padding-bottom: 4px;
    border: 1px solid rgba(139, 92, 246, 0.3);
    border-left: 3px solid rgba(139, 92, 246, 0.6);
}

/* ========================================
   SCROLLBAR MÁS VISIBLE Y FUNCIONAL
   ======================================== */

.sidebar-scrollable {
    scrollbar-width: thin; /* Firefox */
    scrollbar-color: rgba(255, 255, 255, 0.5) rgba(0, 0, 0, 0.1); /* Firefox */
}

.sidebar-scrollable::-webkit-scrollbar {
    width: 12px; /* Más ancho para mejor visibilidad */
}

.sidebar-scrollable::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.15);
    border-radius: 6px;
    margin: 8px 0;
}

.sidebar-scrollable::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.6); /* Más opaco */
    border-radius: 6px;
    border: 2px solid transparent;
    background-clip: padding-box;
}

.sidebar-scrollable::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.8);
    border: 2px solid transparent;
    background-clip: padding-box;
}

.sidebar-scrollable::-webkit-scrollbar-thumb:active {
    background: rgba(255, 255, 255, 0.95);
}

/* ========================================
   REDUCCIÓN DE ESPACIADO EN ITEMS
   ======================================== */

.submenu-link {
    font-size: 12.5px !important;
    padding: 5px 12px !important;
    color: #1e293b !important;  /* Texto oscuro para contraste */
    line-height: 1.5;
    transition: all 0.2s ease;
    font-weight: 500;
}

.submenu-link:hover {
    background: linear-gradient(90deg, rgba(139, 92, 246, 0.35), rgba(99, 102, 241, 0.25)) !important;
    color: #0f172a !important;
    padding-left: 16px !important;  /* Efecto de indent al hover */
    border-left: 2px solid rgba(139, 92, 246, 0.8);
    font-weight: 600;
}

/* ========================================
   HEADERS DE CATEGORÍAS MEJORADOS
   ======================================== */

.submenu-header {
    pointer-events: none;
    margin-top: 6px;
    margin-bottom: 3px;
}

.submenu-category {
    font-size: 10px;
    color: #6d28d9;  /* Morado oscuro */
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    padding: 4px 12px;
    display: block;
    border-top: 1px solid rgba(139, 92, 246, 0.4);
    background: linear-gradient(90deg, rgba(139, 92, 246, 0.2), transparent);
}

.submenu-header:first-child {
    margin-top: 3px;
}

.submenu-header:first-child .submenu-category {
    border-top: none;
}

/* ========================================
   CHEVRON TOGGLE
   ======================================== */

#mantenedoresToggle {
    display: flex;
    align-items: center;
}

#mantenedoresChevron {
    font-size: 11px;
}

#mantenedoresChevron.rotated {
    transform: rotate(90deg);
}

/* ========================================
   PADDING EXTRA INFERIOR PARA SCROLL
   ======================================== */

/* El padding-bottom: 60px en .sidebar-scrollable asegura
   que "Configuración" sea visible con scroll */
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const toggle = document.getElementById('mantenedoresToggle');
    const submenu = document.getElementById('mantenedoresSubmenu');
    const chevron = document.getElementById('mantenedoresChevron');
    const scrollable = document.querySelector('.sidebar-scrollable');
    
    if (toggle && submenu && chevron) {
        toggle.addEventListener('click', function(e) {
            e.preventDefault();
            
            if (submenu.style.display === 'none') {
                submenu.style.display = 'block';
                chevron.classList.add('rotated');
                
                // Hacer scroll suave hacia abajo para mostrar que hay más contenido
                setTimeout(() => {
                    if (scrollable) {
                        scrollable.scrollTo({
                            top: scrollable.scrollTop + 50,
                            behavior: 'smooth'
                        });
                    }
                }, 150);
            } else {
                submenu.style.display = 'none';
                chevron.classList.remove('rotated');
            }
        });
        
        // Mantener abierto si estamos en una página de mantenedor
        if (window.location.pathname.includes('/maintenance') || 
            window.location.pathname.includes('/maintainers')) {
            submenu.style.display = 'block';
            chevron.classList.add('rotated');
        }
    }
});
</script>