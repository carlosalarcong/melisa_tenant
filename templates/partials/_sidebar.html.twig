<aside class="sidebar" id="sidebar" style="display: flex; flex-direction: column; height: 100vh; overflow: hidden;">
    <div class="sidebar-header">
        <div class="clinic-logo">
            <i class="fas fa-clinic-medical fa-2x" style="color: white;"></i>
        </div>
        <h5 class="clinic-name">Melisa Health</h5>
        <small class="clinic-subdomain">{{ tenant_info.subdomain|default('sistema') }}</small>
    </div>
    
    <!-- Contenedor con scroll para el contenido del sidebar -->
    <div style="flex: 1; overflow-y: auto; overflow-x: hidden; padding-bottom: 60px;" class="sidebar-scrollable">
    
    <div class="sidebar-heading">
        <span>Principal</span>
    </div>
    <ul class="nav flex-column">
        <li class="nav-item">
            <a class="nav-link {% if app.request.pathinfo == '/' %}active{% endif %}" href="/">
                <i class="fas fa-home"></i>
                <span class="nav-link-text">Dashboard</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {% if '/users' in app.request.pathinfo %}active{% endif %}" href="/users">
                <i class="fas fa-users-cog"></i>
                <span class="nav-link-text">Usuarios</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {% if '/patients' in app.request.pathinfo %}active{% endif %}" href="/patients">
                <i class="fas fa-hospital-user"></i>
                <span class="nav-link-text">Pacientes</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {% if '/appointments' in app.request.pathinfo %}active{% endif %}" href="/appointments">
                <i class="fas fa-calendar-alt"></i>
                <span class="nav-link-text">Agenda</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {% if '/clinical-records' in app.request.pathinfo %}active{% endif %}" href="/clinical-records">
                <i class="fas fa-file-medical"></i>
                <span class="nav-link-text">Ficha Clínica</span>
            </a>
        </li>
    </ul>
    
    <div class="sidebar-heading">
        <span>Módulos</span>
    </div>
    <ul class="nav flex-column">
        <li class="nav-item">
            <a class="nav-link {% if '/billing' in app.request.pathinfo %}active{% endif %}" href="/billing">
                <i class="fas fa-cash-register"></i>
                <span class="nav-link-text">Caja</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {% if '/pharmacy' in app.request.pathinfo %}active{% endif %}" href="/pharmacy">
                <i class="fas fa-pills"></i>
                <span class="nav-link-text">Farmacia</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {% if '/laboratory' in app.request.pathinfo %}active{% endif %}" href="/laboratory">
                <i class="fas fa-flask"></i>
                <span class="nav-link-text">Laboratorio</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {% if '/reports' in app.request.pathinfo %}active{% endif %}" href="/reports">
                <i class="fas fa-chart-bar"></i>
                <span class="nav-link-text">Informes</span>
            </a>
        </li>
    </ul>
    
    <div class="sidebar-heading">
        <span>Sistema</span>
    </div>
    <ul class="nav flex-column">
        <li class="nav-item">
            <a class="nav-link menu-link {% if '/maintenance' in app.request.pathinfo %}active{% else %}collapsed{% endif %}" 
               href="#sidebarMantenedores" 
               data-bs-toggle="collapse" 
               role="button" 
               aria-expanded="{{ '/maintenance' in app.request.pathinfo ? 'true' : 'false' }}" 
               aria-controls="sidebarMantenedores">
                <i class="fas fa-database"></i>
                <span class="nav-link-text">Mantenedores</span>
            </a>
            
            <!-- Submenú de Mantenedores con Bootstrap Collapse -->
            <div class="collapse menu-dropdown {{ '/maintenance' in app.request.pathinfo ? 'show' : '' }}" id="sidebarMantenedores">
                <ul class="nav nav-sm flex-column">
                    <!-- Categoría: BÁSICOS -->
                    <li class="menu-title">
                        <span>Básicos</span>
                    </li>
                    <li class="nav-item">
                        <a href="#" class="nav-link" title="Disponible después del merge">Sexo</a>
                    </li>
                    <li class="nav-item">
                        <a href="#" class="nav-link" title="Disponible después del merge">Religión</a>
                    </li>
                    <li class="nav-item">
                        <a href="/maintenance/marital-status" class="nav-link">Estado Conyugal</a>
                    </li>
                    <li class="nav-item">
                        <a href="/maintenance/occupation" class="nav-link">Ocupación</a>
                    </li>
                    <li class="nav-item">
                        <a href="/maintenance/education-level" class="nav-link">Nivel Instrucción</a>
                    </li>
                    <li class="nav-item">
                        <a href="/maintenance/ethnic-group" class="nav-link">Pueblo Originario</a>
                    </li>
                    
                    <!-- Categoría: GEOGRÁFICOS -->
                    <li class="menu-title">
                        <span>Geográficos</span>
                    </li>
                    <li class="nav-item">
                        <a href="/maintenance/country" class="nav-link">País</a>
                    </li>
                    <li class="nav-item">
                        <a href="/maintenance/region" class="nav-link">Región</a>
                    </li>
                    <li class="nav-item">
                        <a href="/maintenance/province" class="nav-link">Provincia</a>
                    </li>
                    
                    <!-- Categoría: CLÍNICOS -->
                    <li class="menu-title">
                        <span>Clínicos</span>
                    </li>
                    <li class="nav-item">
                        <a href="/maintenance/doctor-type" class="nav-link">Tipo Médico</a>
                    </li>
                    <li class="nav-item">
                        <a href="/maintenance/medical-box" class="nav-link">Box</a>
                    </li>
                </ul>
            </div>
        </li>
        <li class="nav-item">
            <a class="nav-link {% if '/settings' in app.request.pathinfo %}active{% endif %}" href="/settings">
                <i class="fas fa-cog"></i>
                <span class="nav-link-text">Configuración</span>
            </a>
        </li>
    </ul>
    
    </div> <!-- Cierre del contenedor con scroll -->
</aside>