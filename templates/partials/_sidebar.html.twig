<aside class="sidebar" id="sidebar" style="display: flex; flex-direction: column; height: 100vh; overflow: hidden;">
    <div class="sidebar-header">
        <div class="clinic-logo">
            <i class="fas fa-clinic-medical fa-2x" style="color: white;"></i>
        </div>
        <h5 class="clinic-name">Melisa Health</h5>
        <small class="clinic-subdomain">{{ tenant_info.subdomain|default('sistema') }}</small>
    </div>
    
    <!-- Contenedor con scroll para el contenido del sidebar -->
    <div style="flex: 1; overflow-y: auto; overflow-x: hidden; padding-bottom: 60px;" class="sidebar-scrollable">
    
    <div class="sidebar-heading">
        <span>Principal</span>
    </div>
    <ul class="nav flex-column">
        {% if menu_items is defined %}
            {% for item in menu_items %}
                {% if item.children is empty %}
                    {# Item simple sin hijos #}
                    <li class="nav-item">
                        <a class="nav-link {% if item.route and app.request.get('_route') == item.route %}active{% endif %}" 
                           href="{{ item.route ? path(item.route) : '#' }}">
                            <i class="{{ item.icon|default('fas fa-circle') }}"></i>
                            <span class="nav-link-text">{{ item.label }}</span>
                        </a>
                    </li>
                {% else %}
                    {# Item con submenú colapsable #}
                    <li class="nav-item">
                        <a class="nav-link menu-link {% if item.name in ['mantenedores'] and '/maintenance' in app.request.pathinfo %}active{% else %}collapsed{% endif %}" 
                           href="#sidebar{{ item.name|capitalize }}" 
                           data-bs-toggle="collapse" 
                           role="button" 
                           aria-expanded="{{ '/maintenance' in app.request.pathinfo ? 'true' : 'false' }}" 
                           aria-controls="sidebar{{ item.name|capitalize }}">
                            <i class="{{ item.icon|default('fas fa-folder') }}"></i>
                            <span class="nav-link-text">{{ item.label }}</span>
                        </a>
                        
                        {# Submenú colapsable #}
                        <div class="collapse menu-dropdown {{ '/maintenance' in app.request.pathinfo ? 'show' : '' }}" id="sidebar{{ item.name|capitalize }}">
                            <ul class="nav nav-sm flex-column">
                                {% for child in item.children %}
                                    <li class="nav-item">
                                        <a href="{{ child.route ? path(child.route) : '#' }}" 
                                           class="nav-link {% if child.route and app.request.get('_route') == child.route %}active{% endif %}">
                                            <i class="{{ child.icon|default('bx bx-circle') }}"></i>
                                            {{ child.label }}
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    </li>
                {% endif %}
            {% endfor %}
        {% else %}
            {# Fallback: menú estático si no hay menu_items #}
            <li class="nav-item">
                <a class="nav-link {% if app.request.pathinfo == '/' %}active{% endif %}" href="/">
                    <i class="fas fa-home"></i>
                    <span class="nav-link-text">Dashboard</span>
                </a>
            </li>
        {% endif %}
    </ul>
    
    </div> <!-- Cierre del contenedor con scroll -->
</aside>