<turbo-frame id="maintainer-form">
    {{ form_start(form, {
        'action': action_url|default(''),
        'attr': {
            'novalidate': 'novalidate',
            'data-turbo-frame': '_top'
        }
    }) }}
    
    <div class="mb-3">
        {{ form_row(form.name, {'attr': {'class': 'form-control'}}) }}
    </div>

    {% if form.code is defined %}
        <div class="mb-3">
            {{ form_row(form.code, {'attr': {'class': 'form-control'}}) }}
        </div>
    {% endif %}

    {% if form.description is defined %}
        <div class="mb-3">
            {{ form_row(form.description, {'attr': {'class': 'form-control'}}) }}
        </div>
    {% endif %}

    {% if form.number is defined %}
        <div class="mb-3">
            {{ form_row(form.number, {'attr': {'class': 'form-control'}}) }}
        </div>
    {% endif %}

    {% if form.religionCodeHl7 is defined %}
        <div class="mb-3">
            {{ form_row(form.religionCodeHl7, {'attr': {'class': 'form-control'}}) }}
        </div>
    {% endif %}

    {% if form.maritalStatusCodeHl7 is defined %}
        <div class="mb-3">
            {{ form_row(form.maritalStatusCodeHl7, {'attr': {'class': 'form-control'}}) }}
        </div>
    {% endif %}

    {% if form.educationLevel is defined %}
        <div class="mb-3">
            {{ form_row(form.educationLevel, {'attr': {'class': 'form-control'}}) }}
        </div>
    {% endif %}

    {% if form.originType is defined %}
        <div class="mb-3">
            {{ form_row(form.originType, {'attr': {'class': 'form-control'}}) }}
        </div>
    {% endif %}

    {% if form.isActive is defined %}
        <div class="mb-4">
            <div class="form-check form-switch">
                {{ form_widget(form.isActive, {'attr': {'class': 'form-check-input'}}) }}
                {{ form_label(form.isActive, null, {'label_attr': {'class': 'form-check-label'}}) }}
                {% if form.isActive.vars.errors|length > 0 %}
                    <div class="invalid-feedback d-block">
                        {{ form_errors(form.isActive) }}
                    </div>
                {% endif %}
            </div>
        </div>
    {% endif %}

    {% if form.active is defined %}
        <div class="mb-4">
            <div class="form-check form-switch">
                {{ form_widget(form.active, {'attr': {'class': 'form-check-input'}}) }}
                {{ form_label(form.active, null, {'label_attr': {'class': 'form-check-label'}}) }}
                {% if form.active.vars.errors|length > 0 %}
                    <div class="invalid-feedback d-block">
                        {{ form_errors(form.active) }}
                    </div>
                {% endif %}
            </div>
        </div>
    {% endif %}

    <div class="d-flex justify-content-end gap-2 mt-4">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            <i class="bx bx-x me-1"></i>Cancelar
        </button>
        <button type="submit" class="btn btn-primary">
            <i class="bx bx-save me-1"></i>Guardar
        </button>
    </div>

    {{ form_end(form) }}
</turbo-frame>
