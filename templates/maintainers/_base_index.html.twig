{% extends 'base.html.twig' %}

{% block title %}{{ page_title }} - Melisa{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">
            <i class="bx bx-list-ul me-2"></i>{{ page_title }}
        </h1>
        {% if create_route is defined %}
            <a href="{{ path(create_route) }}" class="btn btn-primary">
                <i class="bx bx-plus me-1"></i>Crear Nuevo
            </a>
        {% endif %}
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bx bx-check-circle me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bx bx-error-circle me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="card shadow-sm">
        <div class="card-body">
            {% if data is empty %}
                <div class="text-center py-5">
                    <i class="bx bx-inbox bx-lg text-muted mb-3" style="font-size: 4rem;"></i>
                    <h5 class="text-muted">No hay registros disponibles</h5>
                    <p class="text-muted mb-3">Comienza agregando el primer elemento</p>
                    {% if create_route is defined %}
                        <a href="{{ path(create_route) }}" class="btn btn-primary">
                            <i class="bx bx-plus me-1"></i>Crear Primero
                        </a>
                    {% endif %}
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                {% for column in columns %}
                                    <th scope="col">
                                        {% if column == 'name' %}Nombre
                                        {% elseif column == 'code' %}Código
                                        {% elseif column == 'isActive' %}Estado
                                        {% elseif column == 'description' %}Descripción
                                        {% elseif column == 'number' %}Número
                                        {% elseif column == 'educationLevel' %}Nivel Instrucción
                                        {% elseif column == 'originType' %}Tipo Origen
                                        {% elseif column == 'religionCodeHl7' %}Código HL7
                                        {% elseif column == 'maritalStatusCodeHl7' %}Código HL7
                                        {% else %}{{ column|title }}
                                        {% endif %}
                                    </th>
                                {% endfor %}
                                <th scope="col" class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in data %}
                                <tr>
                                    {% for column in columns %}
                                        <td>
                                            {% set value = attribute(item, column) %}
                                            {% if column == 'isActive' %}
                                                {% if value %}
                                                    <span class="badge bg-success">
                                                        <i class="bx bx-check me-1"></i>Activo
                                                    </span>
                                                {% else %}
                                                    <span class="badge bg-secondary">
                                                        <i class="bx bx-x me-1"></i>Inactivo
                                                    </span>
                                                {% endif %}
                                            {% elseif column == 'educationLevel' and value %}
                                                {{ value.name }}
                                            {% elseif column == 'originType' and value %}
                                                {{ value.name }}
                                            {% else %}
                                                {{ value ?? '-' }}
                                            {% endif %}
                                        </td>
                                    {% endfor %}
                                    <td class="text-end">
                                        <div class="btn-group" role="group">
                                            {% set edit_route = app.request.attributes.get('_route')|replace({'_index': '_edit'}) %}
                                            <a href="{{ path(edit_route, {'id': item.id}) }}" 
                                               class="btn btn-sm btn-outline-primary" 
                                               title="Editar">
                                                <i class="bx bx-edit-alt"></i>
                                            </a>
                                            {% set delete_route = app.request.attributes.get('_route')|replace({'_index': '_delete'}) %}
                                            <form method="post" 
                                                  action="{{ path(delete_route, {'id': item.id}) }}" 
                                                  class="d-inline"
                                                  onsubmit="return confirm('¿Está seguro de eliminar este elemento?')">
                                                <button type="submit" 
                                                        class="btn btn-sm btn-outline-danger" 
                                                        title="Eliminar">
                                                    <i class="bx bx-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <div class="text-muted">
                        Total: <strong>{{ data|length }}</strong> registro(s)
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
